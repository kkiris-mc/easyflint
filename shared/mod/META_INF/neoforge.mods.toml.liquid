{% include "authors.liquid" -%}
modLoader = "javafml"
license = {{ license }}
showAsDataPack = true

[[mods]]
modId = "{{ mod_id | default: name | downcase | replace: " ", "_" }}"
version = "{{ version }}{% unless no_build_in_version %}+{{ build }}{% endunless %}"
displayName = "{{ name }}"
description = {{ mod_description | default: description | jsonify }}
logoFile = "pack.png"
logoBlue = "false"
authors = "{{ listed_authors | array_to_sentence_string: "&" }}"
{% if hompage %}displayURL = "{{ homepage }}"{% endif %}